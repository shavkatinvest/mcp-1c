// Версия расширения: 0.5.0
// ============================================================

// ── Вспомогательные функции ──────────────────────────────────

Функция РазобратьJSON(СтрокаJSON)
    ЧтениеJSON = Новый ЧтениеJSON;
    ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
    Результат = ПрочитатьJSON(ЧтениеJSON);
    ЧтениеJSON.Закрыть();
    Возврат Результат;
КонецФункции

Функция ПреобразоватьЗначениеПараметра(Знач Значение)
    // Значения query-параметров приходят из JSON строками. Если строка имеет ISO-формат
    // даты ("ГГГГ-ММ-ДД" или "ГГГГ-ММ-ДДTчч:мм:сс"), приводим её к типу Дата — иначе
    // виртуальные таблицы (.Остатки(&Дата, ...)) дают "Несоответствие типов (Параметр номер 1)".
    // Нестроковые значения и строки иного вида возвращаются без изменений; при неудаче
    // разбора возвращается исходная строка (безопасный откат к прежнему поведению).
    Если ТипЗнч(Значение) <> Тип("Строка") Тогда
        Возврат Значение;
    КонецЕсли;

    Длина = СтрДлина(Значение);
    РазделителиДаты = (Сред(Значение, 5, 1) = "-") И (Сред(Значение, 8, 1) = "-");
    ЭтоДата = (Длина = 10) И РазделителиДаты;
    ЭтоДатаВремя = (Длина >= 19) И РазделителиДаты
        И (Сред(Значение, 11, 1) = "T" ИЛИ Сред(Значение, 11, 1) = " ")
        И (Сред(Значение, 14, 1) = ":") И (Сред(Значение, 17, 1) = ":");

    Если НЕ (ЭтоДата ИЛИ ЭтоДатаВремя) Тогда
        Возврат Значение;
    КонецЕсли;

    Если ЭтоДата Тогда
        СтрокаДаты = Значение + "T00:00:00";
    Иначе
        СтрокаДаты = СтрЗаменить(Лев(Значение, 19), " ", "T");
    КонецЕсли;

    Попытка
        Возврат XMLЗначение(Тип("Дата"), СтрокаДаты);
    Исключение
        Возврат Значение;
    КонецПопытки;
КонецФункции

Функция СформироватьJSON(Значение)
    ЗаписьJSON = Новый ЗаписьJSON;
    ЗаписьJSON.УстановитьСтроку();
    ЗаписатьJSON(ЗаписьJSON, Значение);
    Возврат ЗаписьJSON.Закрыть();
КонецФункции

Функция ОтветJSON(Значение)
    Ответ = Новый HTTPСервисОтвет(200);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Значение));
    Возврат Ответ;
КонецФункции

Функция ОтветОшибка(КодСостояния, ТекстОшибки)
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Новый Структура("error", ТекстОшибки)));
    Возврат Ответ;
КонецФункции

// ОтветОшибкаКод — структурированный ответ об ошибке для write-эндпоинтов
// ({"error": КодОшибки, "message": Сообщение, "field": Поле}). В отличие от
// ОтветОшибка (используется read-эндпоинтами, единственное поле "error" содержит
// текст) здесь "error" — машиночитаемый код, а человекочитаемый текст — в "message".
// Так Go-слой может различать причины сбоя (unknown_document_type, write_failed, ...)
// не парся текст на естественном языке.
Функция ОтветОшибкаКод(КодСостояния, КодОшибки, Сообщение, Поле = Неопределено)
    Стр = Новый Структура;
    Стр.Вставить("error", КодОшибки);
    Стр.Вставить("message", Сообщение);
    Если Поле <> Неопределено Тогда
        Стр.Вставить("field", Поле);
    КонецЕсли;
    Ответ = Новый HTTPСервисОтвет(КодСостояния);
    Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
    Ответ.УстановитьТелоИзСтроки(СформироватьJSON(Стр));
    Возврат Ответ;
КонецФункции

// ТекстыСообщенийПользователю — многие типовые/БСП проверки заполнения и
// проведения сообщают о причине отказа через СообщитьПользователю(), а не
// через текст самого исключения — без этого ОписаниеОшибки() в catch-блоке
// часто содержит лишь общую фразу вида "Не удалось записать: <Представление>!"
// без сути проверки. Забирает и очищает очередь сообщений (Истина = очистить).
Функция ТекстыСообщенийПользователю()
    Тексты = Новый Массив;
    Для Каждого Сообщение Из ПолучитьСообщенияПользователю(Истина) Цикл
        Тексты.Добавить(Сообщение.Текст);
    КонецЦикла;
    Возврат СтрСоединить(Тексты, "; ");
КонецФункции

Функция НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта)
    Соответствие = Новый Соответствие;
    Соответствие.Вставить("Catalog",                      Метаданные.Справочники);
    Соответствие.Вставить("Document",                     Метаданные.Документы);
    Соответствие.Вставить("Enum",                         Метаданные.Перечисления);
    Соответствие.Вставить("DataProcessor",                Метаданные.Обработки);
    Соответствие.Вставить("Report",                       Метаданные.Отчеты);
    Соответствие.Вставить("InformationRegister",          Метаданные.РегистрыСведений);
    Соответствие.Вставить("AccumulationRegister",         Метаданные.РегистрыНакопления);
    Соответствие.Вставить("AccountingRegister",           Метаданные.РегистрыБухгалтерии);
    Соответствие.Вставить("CalculationRegister",          Метаданные.РегистрыРасчета);
    Соответствие.Вставить("ChartOfAccounts",              Метаданные.ПланыСчетов);
    Соответствие.Вставить("ChartOfCharacteristicTypes",   Метаданные.ПланыВидовХарактеристик);
    Соответствие.Вставить("ChartOfCalculationTypes",      Метаданные.ПланыВидовРасчета);
    Соответствие.Вставить("ExchangePlan",                 Метаданные.ПланыОбмена);
    Соответствие.Вставить("BusinessProcess",              Метаданные.БизнесПроцессы);
    Соответствие.Вставить("Task",                         Метаданные.Задачи);

    Коллекция = Соответствие[ТипОбъекта];
    Если Коллекция = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Возврат Коллекция.Найти(ИмяОбъекта);
КонецФункции

Функция ЕстьКоллекция(ОбъектМД, ИмяКоллекции)
    Попытка
        Значение = ОбъектМД[ИмяКоллекции];
        Возврат Истина;
    Исключение
        Возврат Ложь;
    КонецПопытки;
КонецФункции

// РазрешитьСсылку — по строковому имени ссылочного типа ("СправочникСсылка.Организации")
// и GUID возвращает ссылку через соответствующий менеджер ("Справочники.Организации.
// ПолучитьСсылку(Ид)"). Работает для любого ссылочного типа платформы без знания
// конкретной коллекции заранее — вид ссылки и имя объекта разбираются из строки.
Функция РазрешитьСсылку(ИмяТипаСсылки, ЗначениеGUID)
    Части = СтрРазделить(ИмяТипаСсылки, ".", Ложь);
    Если Части.Количество() <> 2 Тогда
        Возврат Неопределено;
    КонецЕсли;

    ВидСсылки = Части[0];
    ИмяОбъекта = Части[1];

    Соответствие = Новый Соответствие;
    Соответствие.Вставить("СправочникСсылка",                 Справочники);
    Соответствие.Вставить("ДокументСсылка",                   Документы);
    Соответствие.Вставить("ПланСчетовСсылка",                 ПланыСчетов);
    Соответствие.Вставить("ПланВидовХарактеристикСсылка",     ПланыВидовХарактеристик);
    Соответствие.Вставить("ПланВидовРасчетаСсылка",           ПланыВидовРасчета);
    Соответствие.Вставить("ПланОбменаСсылка",                 ПланыОбмена);
    Соответствие.Вставить("БизнесПроцессСсылка",               БизнесПроцессы);
    Соответствие.Вставить("ЗадачаСсылка",                      Задачи);

    Менеджер = Соответствие[ВидСсылки];
    Если Менеджер = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    Попытка
        МенеджерОбъекта = Менеджер[ИмяОбъекта];
        Возврат МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(ЗначениеGUID));
    Исключение
        Возврат Неопределено;
    КонецПопытки;
КонецФункции

// ПреобразоватьЗначениеРеквизита — приводит JSON-значение к типу конкретного
// реквизита метаданных перед записью в объект: даты — через ПреобразоватьЗначениеПараметра,
// ссылочные типы — через РазрешитьСсылку (значение из JSON в этом случае должно быть
// строкой с GUID), остальное — без изменений.
Функция ПреобразоватьЗначениеРеквизита(ОписаниеРеквизита, ИсходноеЗначение)
    Если ИсходноеЗначение = Неопределено Тогда
        Возврат Неопределено;
    КонецЕсли;

    МассивТипов = ОписаниеРеквизита.Тип.Типы();
    Если МассивТипов.Количество() = 0 Тогда
        Возврат ПреобразоватьЗначениеПараметра(ИсходноеЗначение);
    КонецЕсли;

    ЦелевойТип = МассивТипов[0];
    ИмяТипа = Строка(ЦелевойТип);

    Если СтрНайти(ИмяТипа, "Ссылка") > 0 И ТипЗнч(ИсходноеЗначение) = Тип("Строка") Тогда
        Ссылка = РазрешитьСсылку(ИмяТипа, ИсходноеЗначение);
        Если Ссылка = Неопределено Тогда
            ВызватьИсключение "Не удалось найти объект типа '" + ИмяТипа + "' по идентификатору '" + ИсходноеЗначение + "'";
        КонецЕсли;
        Возврат Ссылка;
    КонецЕсли;

    Возврат ПреобразоватьЗначениеПараметра(ИсходноеЗначение);
КонецФункции

// УстановитьРеквизиты — заполняет реквизиты объекта (шапку документа) из
// Structure {ИмяРеквизита: Значение}, полученной из JSON. Бросает исключение
// с понятным текстом, если реквизит не найден в метаданных объекта.
Процедура УстановитьРеквизиты(Объект, ОбъектМД, ЗначенияРеквизитов)
    Для Каждого КлючИЗначение Из ЗначенияРеквизитов Цикл
        ИмяРеквизита = КлючИЗначение.Ключ;

        ОписаниеРеквизита = Неопределено;
        Если ЕстьКоллекция(ОбъектМД, "Реквизиты") Тогда
            ОписаниеРеквизита = ОбъектМД.Реквизиты.Найти(ИмяРеквизита);
        КонецЕсли;

        Если ОписаниеРеквизита = Неопределено Тогда
            ВызватьИсключение "Реквизит '" + ИмяРеквизита + "' не найден у объекта " + ОбъектМД.Имя;
        КонецЕсли;

        Объект[ИмяРеквизита] = ПреобразоватьЗначениеРеквизита(ОписаниеРеквизита, КлючИЗначение.Значение);
    КонецЦикла;
КонецПроцедуры

// УстановитьТабличныеЧасти — заполняет табличные части объекта из Structure
// {ИмяТЧ: Массив(Structure{ИмяРеквизита: Значение})}. Каждая строка добавляется
// через Добавить() табличной части — существующие строки не затрагиваются
// (вызывается только для только что созданного объекта).
Процедура УстановитьТабличныеЧасти(Объект, ОбъектМД, ЗначенияТЧ)
    Для Каждого ИмяТСИЗначение Из ЗначенияТЧ Цикл
        ИмяТЧ = ИмяТСИЗначение.Ключ;
        Строки = ИмяТСИЗначение.Значение;

        ОписаниеТЧ = Неопределено;
        Если ЕстьКоллекция(ОбъектМД, "ТабличныеЧасти") Тогда
            ОписаниеТЧ = ОбъектМД.ТабличныеЧасти.Найти(ИмяТЧ);
        КонецЕсли;
        Если ОписаниеТЧ = Неопределено Тогда
            ВызватьИсключение "Табличная часть '" + ИмяТЧ + "' не найдена у объекта " + ОбъектМД.Имя;
        КонецЕсли;

        Если ТипЗнч(Строки) <> Тип("Массив") Тогда
            Продолжить;
        КонецЕсли;

        ТЧОбъекта = Объект[ИмяТЧ];
        Для Каждого СтрокаДанные Из Строки Цикл
            НоваяСтрокаТЧ = ТЧОбъекта.Добавить();
            Для Каждого КлючИЗначение Из СтрокаДанные Цикл
                ОписаниеРеквизитаТЧ = ОписаниеТЧ.Реквизиты.Найти(КлючИЗначение.Ключ);
                Если ОписаниеРеквизитаТЧ = Неопределено Тогда
                    ВызватьИсключение "Реквизит '" + КлючИЗначение.Ключ + "' не найден в табличной части '" + ИмяТЧ + "'";
                КонецЕсли;
                НоваяСтрокаТЧ[КлючИЗначение.Ключ] = ПреобразоватьЗначениеРеквизита(ОписаниеРеквизитаТЧ, КлючИЗначение.Значение);
            КонецЦикла;
        КонецЦикла;
    КонецЦикла;
КонецПроцедуры

Функция ПривестиЗначениеКJSON(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    Иначе
        Возврат Строка(Значение);
    КонецЕсли;
КонецФункции

// ЗначениеАтрибутаКJSON — как ПривестиЗначениеКJSON, но для ссылочных значений
// возвращает {"presentation": Строка(Значение), "ref": GUID} вместо простой
// строки-представления. Используется в GET-обработчиках объектов (документ,
// справочник), чтобы вызывающий (LLM) сразу получал GUID для последующего
// update/find без отдельного execute_query. Для примитивных типов поведение
// идентично ПривестиЗначениеКJSON (которая не меняется — от неё зависит
// execute_query, где ссылки традиционно отдаются простым представлением).
Функция ЗначениеАтрибутаКJSON(Значение)
    Если Значение = Неопределено ИЛИ Значение = NULL Тогда
        Возврат "";
    ИначеЕсли ТипЗнч(Значение) = Тип("Число") ИЛИ ТипЗнч(Значение) = Тип("Булево") Тогда
        Возврат Значение;
    ИначеЕсли ТипЗнч(Значение) = Тип("Строка") ИЛИ ТипЗнч(Значение) = Тип("Дата") Тогда
        Возврат Строка(Значение);
    КонецЕсли;

    Попытка
        Ид = Значение.УникальныйИдентификатор();
        Рез = Новый Структура;
        Рез.Вставить("presentation", Строка(Значение));
        Рез.Вставить("ref", Строка(Ид));
        Возврат Рез;
    Исключение
        Возврат Строка(Значение);
    КонецПопытки;
КонецФункции

// СериализоватьРеквизитыИТЧ — общая часть GET-обработчиков объекта (документ,
// справочник): заполняет в Результат ключи "attributes" и "tabular_sections"
// на основе метаданных объекта. Ссылочные значения проходят через
// ЗначениеАтрибутаКJSON (presentation+ref).
Процедура СериализоватьРеквизитыИТЧ(Объект, ОбъектМД, Результат)
    Атрибуты = Новый Структура;
    Если ЕстьКоллекция(ОбъектМД, "Реквизиты") Тогда
        Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
            Атрибуты.Вставить(Реквизит.Имя, ЗначениеАтрибутаКJSON(Объект[Реквизит.Имя]));
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("attributes", Атрибуты);

    ТабличныеЧасти = Новый Структура;
    Если ЕстьКоллекция(ОбъектМД, "ТабличныеЧасти") Тогда
        Для Каждого ОписаниеТЧ Из ОбъектМД.ТабличныеЧасти Цикл
            Строки = Новый Массив;
            ТЧОбъекта = Объект[ОписаниеТЧ.Имя];
            Для Каждого СтрокаТЧ Из ТЧОбъекта Цикл
                СтрокаJSON = Новый Структура;
                Для Каждого РеквизитТЧ Из ОписаниеТЧ.Реквизиты Цикл
                    СтрокаJSON.Вставить(РеквизитТЧ.Имя, ЗначениеАтрибутаКJSON(СтрокаТЧ[РеквизитТЧ.Имя]));
                КонецЦикла;
                Строки.Добавить(СтрокаJSON);
            КонецЦикла;
            ТабличныеЧасти.Вставить(ОписаниеТЧ.Имя, Строки);
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("tabular_sections", ТабличныеЧасти);
КонецПроцедуры

// ОтделитьСтандартныеРеквизитыСправочника — заполняет стандартные реквизиты
// справочника (Наименование, Код, Родитель, Владелец), которых нет в
// ОбъектМД.Реквизиты и поэтому УстановитьРеквизиты не может их обработать.
// Родитель/Владелец передаются в JSON как GUID и разрешаются через
// РазрешитьСсылку. ИмяТипаВладельца — необязательное явное имя типа-владельца
// (для справочников с несколькими видами владельцев); по умолчанию берётся
// первый из ОбъектМД.Владельцы. Возвращает Структуру с ОСТАВШИМИСЯ (не
// стандартными) парами ключ-значение — её передают дальше в УстановитьРеквизиты.
// Новая Структура строится, а не удаляются элементы из Значения, потому что
// изменять коллекцию во время обхода Для Каждого небезопасно.
Функция ОтделитьСтандартныеРеквизитыСправочника(Объект, ОбъектМД, Значения, ИмяТипаВладельца = Неопределено)
    Остальные = Новый Структура;

    Для Каждого КлючИЗначение Из Значения Цикл
        Имя = КлючИЗначение.Ключ;
        ИсходноеЗначение = КлючИЗначение.Значение;

        Если Имя = "Наименование" Тогда
            Если ОбъектМД.ДлинаНаименования = 0 Тогда
                ВызватьИсключение "Справочник '" + ОбъектМД.Имя + "' не имеет реквизита 'Наименование'";
            КонецЕсли;
            Объект.Наименование = ИсходноеЗначение;
        ИначеЕсли Имя = "Код" Тогда
            Если ОбъектМД.ДлинаКода = 0 Тогда
                ВызватьИсключение "Справочник '" + ОбъектМД.Имя + "' не имеет реквизита 'Код'";
            КонецЕсли;
            Объект.Код = ИсходноеЗначение;
        ИначеЕсли Имя = "Родитель" Тогда
            Если НЕ ОбъектМД.Иерархический Тогда
                ВызватьИсключение "Справочник '" + ОбъектМД.Имя + "' не является иерархическим — 'Родитель' недопустим";
            КонецЕсли;
            Родитель = РазрешитьСсылку("СправочникСсылка." + ОбъектМД.Имя, ИсходноеЗначение);
            Если Родитель = Неопределено Тогда
                ВызватьИсключение "Не удалось найти родителя по идентификатору '" + ИсходноеЗначение + "'";
            КонецЕсли;
            Объект.Родитель = Родитель;
        ИначеЕсли Имя = "Владелец" Тогда
            Если ОбъектМД.Владельцы.Количество() = 0 Тогда
                ВызватьИсключение "Справочник '" + ОбъектМД.Имя + "' не является подчинённым (нет владельцев)";
            КонецЕсли;
            ИмяВладельца = ИмяТипаВладельца;
            Если ИмяВладельца = Неопределено Тогда
                ИмяВладельца = ОбъектМД.Владельцы[0].Имя;
            КонецЕсли;
            Владелец = РазрешитьСсылку("СправочникСсылка." + ИмяВладельца, ИсходноеЗначение);
            Если Владелец = Неопределено Тогда
                ВызватьИсключение "Не удалось найти владельца типа '" + ИмяВладельца + "' по идентификатору '" + ИсходноеЗначение + "'";
            КонецЕсли;
            Объект.Владелец = Владелец;
        Иначе
            Остальные.Вставить(Имя, ИсходноеЗначение);
        КонецЕсли;
    КонецЦикла;

    Возврат Остальные;
КонецФункции

// ОтделитьСтандартныеРеквизитыДокумента — как ОтделитьСтандартныеРеквизитыСправочника,
// но для документов: "Дата" — единственный стандартный реквизит шапки, который
// отделяется здесь (её нет в ОбъектМД.Реквизиты, обращение через
// УстановитьРеквизиты бросило бы "Реквизит 'Дата' не найден у объекта ..." —
// найдено при сквозном тесте на реальной базе, см. docs/WRITE-TOOLS.md).
// "Номер" намеренно НЕ обрабатывается — ручная установка номера обходит
// автонумерацию платформы; при необходимости 1С сама выдаст следующий номер.
Функция ОтделитьСтандартныеРеквизитыДокумента(Объект, Значения)
    Остальные = Новый Структура;

    Для Каждого КлючИЗначение Из Значения Цикл
        Имя = КлючИЗначение.Ключ;
        ИсходноеЗначение = КлючИЗначение.Значение;

        Если Имя = "Дата" Тогда
            Объект.Дата = ПреобразоватьЗначениеПараметра(ИсходноеЗначение);
        Иначе
            Остальные.Вставить(Имя, ИсходноеЗначение);
        КонецЕсли;
    КонецЦикла;

    Возврат Остальные;
КонецФункции

// ПараметрЗапроса — читает query-string параметр HTTP-запроса (не путать с
// ПараметрыURL — параметрами шаблона вида {type}). Возвращает ПоУмолчанию,
// если параметр не передан.
// ВАЖНО: ПараметрыЗапроса имеет тип ФиксированноеСоответствие (подтверждено
// runtime-проверкой ТипЗнч), а не Структура — обращение через [Имя] к
// отсутствующему ключу бросает "Поле объекта не обнаружено", метода Свойство()
// у Соответствие нет. Безопасный способ — Получить(Ключ), который возвращает
// Неопределено, если ключ отсутствует.
Функция ПараметрЗапроса(Запрос, Имя, ПоУмолчанию = "")
    Значение = Запрос.ПараметрыЗапроса.Получить(Имя);
    Если Значение = Неопределено Тогда
        Возврат ПоУмолчанию;
    КонецЕсли;
    Возврат Значение;
КонецФункции

// ЭкранироватьДляПодобно — экранирует спецсимволы оператора ПОДОБНО (% _ [ ~)
// последовательностью "~", чтобы пользовательский текст поиска не трактовался
// как шаблон (см. СПЕЦСИМВОЛ "~" в тексте запроса ПоискСсылкиGET).
Функция ЭкранироватьДляПодобно(Знач Текст)
    Текст = СтрЗаменить(Текст, "~", "~~");
    Текст = СтрЗаменить(Текст, "%", "~%");
    Текст = СтрЗаменить(Текст, "_", "~_");
    Текст = СтрЗаменить(Текст, "[", "~[");
    Возврат Текст;
КонецФункции

Функция ПолучитьОсновнуюФорму(ОбъектМД)
    МассивОсновных = Новый Массив;
    МассивОсновных.Добавить("ОсновнаяФормаОбъекта");
    МассивОсновных.Добавить("ОсновнаяФормаСписка");
    МассивОсновных.Добавить("ОсновнаяФормаВыбора");
    МассивОсновных.Добавить("ОсновнаяФорма");

    Для Каждого ИмяСвойства Из МассивОсновных Цикл
        Попытка
            ОсновнаяФорма = ОбъектМД[ИмяСвойства];
            Если ОсновнаяФорма <> Неопределено Тогда
                Возврат ОсновнаяФорма;
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;

    Попытка
        Если ОбъектМД.Формы.Количество() > 0 Тогда
            Для Каждого ФормаМД Из ОбъектМД.Формы Цикл
                Возврат ФормаМД;
            КонецЦикла;
        КонецЕсли;
    Исключение
    КонецПопытки;

    Возврат Неопределено;
КонецФункции

