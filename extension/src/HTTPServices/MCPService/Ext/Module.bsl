    КонецЦикла;

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /object/{type}/{name}
Функция ОбъектGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("name", ОбъектМД.Имя);
    Результат.Вставить("synonym", ОбъектМД.Синоним);

    Реквизиты = Новый Массив;
    Если ЕстьКоллекция(ОбъектМД, "Реквизиты") Тогда
        Для Каждого Реквизит Из ОбъектМД.Реквизиты Цикл
            ОписаниеРеквизита = Новый Структура;
            ОписаниеРеквизита.Вставить("name", Реквизит.Имя);
            ОписаниеРеквизита.Вставить("synonym", Реквизит.Синоним);
            ОписаниеРеквизита.Вставить("type", Строка(Реквизит.Тип));
            Реквизиты.Добавить(ОписаниеРеквизита);
        КонецЦикла;
    КонецЕсли;
    Результат.Вставить("attributes", Реквизиты);

    Если ЕстьКоллекция(ОбъектМД, "ТабличныеЧасти") Тогда
        ТЧ = Новый Массив;
        Для Каждого ТабличнаяЧасть Из ОбъектМД.ТабличныеЧасти Цикл
            ОписаниеТЧ = Новый Структура;
            ОписаниеТЧ.Вставить("name", ТабличнаяЧасть.Имя);
            РеквизитыТЧ = Новый Массив;
            Для Каждого Реквизит Из ТабличнаяЧасть.Реквизиты Цикл
                Описание = Новый Структура;
                Описание.Вставить("name", Реквизит.Имя);
                Описание.Вставить("synonym", Реквизит.Синоним);
                Описание.Вставить("type", Строка(Реквизит.Тип));
                РеквизитыТЧ.Добавить(Описание);
            КонецЦикла;
            ОписаниеТЧ.Вставить("attributes", РеквизитыТЧ);
            ТЧ.Добавить(ОписаниеТЧ);
        КонецЦикла;
        Результат.Вставить("tabularParts", ТЧ);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "Измерения") Тогда
        Измерения = Новый Массив;
        Для Каждого Измерение Из ОбъектМД.Измерения Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Измерение.Имя);
            Описание.Вставить("synonym", Измерение.Синоним);
            Описание.Вставить("type", Строка(Измерение.Тип));
            Измерения.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("dimensions", Измерения);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "Ресурсы") Тогда
        Ресурсы = Новый Массив;
        Для Каждого Ресурс Из ОбъектМД.Ресурсы Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Ресурс.Имя);
            Описание.Вставить("synonym", Ресурс.Синоним);
            Описание.Вставить("type", Строка(Ресурс.Тип));
            Ресурсы.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("resources", Ресурсы);
    КонецЕсли;

    Если ЕстьКоллекция(ОбъектМД, "ЗначенияПеречисления") Тогда
        Значения = Новый Массив;
        Для Каждого Значение Из ОбъектМД.ЗначенияПеречисления Цикл
            Описание = Новый Структура;
            Описание.Вставить("name", Значение.Имя);
            Описание.Вставить("synonym", Значение.Синоним);
            Описание.Вставить("comment", Значение.Комментарий);
            Значения.Добавить(Описание);
        КонецЦикла;
        Результат.Вставить("values", Значения);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /query
Функция ЗапросPOST(Запрос)
    Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

    ТекстЗапроса = Параметры.query;
    Лимит = 100;
    Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
        Лимит = Мин(Параметры.limit, 1000);
    КонецЕсли;

    Префикс = ВРег(СокрЛП(Лев(ТекстЗапроса, 10)));
    Если Лев(Префикс, 7) <> "ВЫБРАТЬ" И Лев(Префикс, 6) <> "SELECT" Тогда
        Возврат ОтветОшибка(400, "Only SELECT queries allowed");
    КонецЕсли;

    Попытка
        Запрос1С = Новый Запрос(ТекстЗапроса);

        Если Параметры.Свойство("parameters") И ТипЗнч(Параметры.parameters) = Тип("Структура") Тогда
            Для Каждого КлючИЗначение Из Параметры.parameters Цикл
                Запрос1С.УстановитьПараметр(КлючИЗначение.Ключ, ПреобразоватьЗначениеПараметра(КлючИЗначение.Значение));
            КонецЦикла;
        КонецЕсли;

        РезультатЗапроса = Запрос1С.Выполнить();
    Исключение
        Возврат ОтветОшибка(400, ОписаниеОшибки());
    КонецПопытки;

    Выборка = РезультатЗапроса.Выбрать();

    Колонки = Новый Массив;
    Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
        Колонки.Добавить(Колонка.Имя);
    КонецЦикла;

    Строки = Новый Массив;
    Счетчик = 0;
    Усечено = Ложь;
    Пока Выборка.Следующий() Цикл
        Если Счетчик >= Лимит Тогда
            Усечено = Истина;
            Прервать;
        КонецЕсли;
        Строка = Новый Массив;
        Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
            Строка.Добавить(ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
        КонецЦикла;
        Строки.Добавить(Строка);
        Счетчик = Счетчик + 1;
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("columns", Колонки);
    Результат.Вставить("rows", Строки);
    Результат.Вставить("total", Счетчик);
    Результат.Вставить("truncated", Усечено);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /configuration
Функция КонфигурацияGET(Запрос)
    Результат = Новый Структура;
    Результат.Вставить("name",             Метаданные.Имя);
    Результат.Вставить("version",          Метаданные.Версия);
    Результат.Вставить("vendor",           Метаданные.Поставщик);
    СИ = Новый СистемнаяИнформация;
    Результат.Вставить("platform_version", СИ.ВерсияПриложения);

    РежимИБ = "";
    Попытка
        СтрокаСоединения = СтрокаСоединенияИнформационнойБазы();
        Если СтрНайти(ВРег(СтрокаСоединения), "FILE=") > 0 Тогда
            РежимИБ = "file";
        ИначеЕсли СтрНайти(ВРег(СтрокаСоединения), "SRVR=") > 0 Тогда
            РежимИБ = "server";
        КонецЕсли;
    Исключение
    КонецПопытки;
    Результат.Вставить("mode", РежимИБ);

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /version
Функция ВерсияGET(Запрос)
    Результат = Новый Структура;
    Результат.Вставить("version", "0.5.0");

    Возврат ОтветJSON(Результат);
КонецФункции

// GET /form/{type}/{name}
Функция ФормаGET(Запрос)
    ТипОбъекта = Запрос.ПараметрыURL["type"];
    ИмяОбъекта = Запрос.ПараметрыURL["name"];

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ТипОбъекта, ИмяОбъекта);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибка(404, "Object not found");
    КонецЕсли;

    Форма = ПолучитьОсновнуюФорму(ОбъектМД);
    Если Форма = Неопределено Тогда
        Возврат ОтветОшибка(404, "Form not found");
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("name", Форма.Имя);
    Результат.Вставить("title", Форма.Синоним);

    // Элементы формы (могут быть недоступны в режиме Предприятия)
    Элементы = Новый Массив;
    Попытка
        Для Каждого Элемент Из Форма.Элементы Цикл
            ОписаниеЭлемента = Новый Структура;
            ОписаниеЭлемента.Вставить("name", Элемент.Имя);
            ОписаниеЭлемента.Вставить("type", Строка(ТипЗнч(Элемент)));
            Попытка
                ОписаниеЭлемента.Вставить("title", Элемент.Заголовок);
            Исключение
                ОписаниеЭлемента.Вставить("title", "");
            КонецПопытки;
            Попытка
                ОписаниеЭлемента.Вставить("dataPath", Строка(Элемент.ПутьКДанным));
            Исключение
                ОписаниеЭлемента.Вставить("dataPath", "");
            КонецПопытки;
            Элементы.Добавить(ОписаниеЭлемента);
        КонецЦикла;
    Исключение
    КонецПопытки;
    Результат.Вставить("elements", Элементы);

    // Команды формы (могут быть недоступны в режиме Предприятия)
    Команды = Новый Массив;
    Попытка
        Для Каждого Команда Из Форма.Команды Цикл
            ОписаниеКоманды = Новый Структура;
            ОписаниеКоманды.Вставить("name", Команда.Имя);
            ОписаниеКоманды.Вставить("action", Команда.Действие);
            Команды.Добавить(ОписаниеКоманды);
        КонецЦикла;
    Исключение
    КонецПопытки;
    Результат.Вставить("commands", Команды);

    // Обработчики событий формы
    Обработчики = Новый Массив;
    МассивСобытий = Новый Массив;
    МассивСобытий.Добавить("ПриОткрытии");
    МассивСобытий.Добавить("ПриСозданииНаСервере");
    МассивСобытий.Добавить("ПередЗаписью");
    МассивСобытий.Добавить("ПриЗаписиНаСервере");
    МассивСобытий.Добавить("ПослеЗаписиНаСервере");
    МассивСобытий.Добавить("ПередЗакрытием");
    МассивСобытий.Добавить("ОбработкаОповещения");
    МассивСобытий.Добавить("ОбработкаНавигационнойСсылки");
    МассивСобытий.Добавить("ОбработкаВыбора");

    Для Каждого ИмяСобытия Из МассивСобытий Цикл
        Попытка
            ИмяОбработчика = Форма[ИмяСобытия];
            Если Не ПустаяСтрока(ИмяОбработчика) Тогда
                ОписаниеОбработчика = Новый Структура;
                ОписаниеОбработчика.Вставить("event", ИмяСобытия);
                ОписаниеОбработчика.Вставить("handler", ИмяОбработчика);
                Обработчики.Добавить(ОписаниеОбработчика);
            КонецЕсли;
        Исключение
            Продолжить;
        КонецПопытки;
    КонецЦикла;
    Результат.Вставить("handlers", Обработчики);

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /validate-query
Функция ПроверкаЗапросаPOST(Запрос)
    Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());

    ТекстЗапроса = Параметры.query;
    Если ПустаяСтрока(ТекстЗапроса) Тогда
        Возврат ОтветОшибка(400, "query is required");
    КонецЕсли;

    Ошибки = Новый Массив;

    Попытка
        СхемаЗапроса = Новый СхемаЗапроса;
        СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);
        СхемаЗапроса.ПолучитьТекстЗапроса();

        Результат = Новый Структура;
        Результат.Вставить("valid", Истина);
        Результат.Вставить("errors", Ошибки);
    Исключение
        Результат = Новый Структура;
        Результат.Вставить("valid", Ложь);
        Ошибки.Добавить(ОписаниеОшибки());
        Результат.Вставить("errors", Ошибки);
    КонецПопытки;

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /eventlog
Функция ЖурналРегистрацииPOST(Запрос)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Параметры = Новый Структура;
    КонецПопытки;

    Отбор = Новый Структура;

    Если Параметры.Свойство("start_date") И ЗначениеЗаполнено(Параметры.start_date) Тогда
        Попытка
            Отбор.Вставить("ДатаНачала", XMLЗначение(Тип("Дата"), Параметры.start_date));
        Исключение
        КонецПопытки;
    КонецЕсли;

    Если Параметры.Свойство("end_date") И ЗначениеЗаполнено(Параметры.end_date) Тогда
        Попытка
            Отбор.Вставить("ДатаОкончания", XMLЗначение(Тип("Дата"), Параметры.end_date));
        Исключение
        КонецПопытки;
    КонецЕсли;

    Если Параметры.Свойство("level") И ЗначениеЗаполнено(Параметры.level) Тогда
        СоответствиеУровней = Новый Соответствие;
        СоответствиеУровней.Вставить("Ошибка",        УровеньЖурналаРегистрации.Ошибка);
        СоответствиеУровней.Вставить("Предупреждение", УровеньЖурналаРегистрации.Предупреждение);
        СоответствиеУровней.Вставить("Информация",     УровеньЖурналаРегистрации.Информация);
        СоответствиеУровней.Вставить("Примечание",     УровеньЖурналаРегистрации.Примечание);
        Уровень = СоответствиеУровней[Параметры.level];
        Если Уровень <> Неопределено Тогда
            МассивУровней = Новый Массив;
            МассивУровней.Добавить(Уровень);
            Отбор.Вставить("Уровень", МассивУровней);
        КонецЕсли;
    КонецЕсли;

    Если Параметры.Свойство("user") И ЗначениеЗаполнено(Параметры.user) Тогда
        Попытка
            ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоИмени(Параметры.user);
            Если ПользовательИБ <> Неопределено Тогда
                МассивПользователей = Новый Массив;
                МассивПользователей.Добавить(ПользовательИБ);
                Отбор.Вставить("Пользователь", МассивПользователей);
            КонецЕсли;
        Исключение
            // Нет права Администрирование — фильтр по пользователю не применяется
        КонецПопытки;
    КонецЕсли;

    Лимит = 50;
    Если Параметры.Свойство("limit") И Параметры.limit > 0 Тогда
        Лимит = Мин(Параметры.limit, 500);
    КонецЕсли;

    // Защита от OOM: если не указана дата начала, ограничиваем последними 7 днями
    Если НЕ Отбор.Свойство("ДатаНачала") Тогда
        Отбор.Вставить("ДатаНачала", ТекущаяДата() - 7 * 86400);
    КонецЕсли;

    ТаблицаЖурнала = Новый ТаблицаЗначений;
    ВыгрузитьЖурналРегистрации(ТаблицаЖурнала, Отбор);

    ВсегоЗаписей = ТаблицаЖурнала.Количество();

    МассивСобытий = Новый Массив;
    Для Индекс = 0 По Мин(Лимит, ВсегоЗаписей) - 1 Цикл
        Строка = ТаблицаЖурнала[Индекс];
        Событие = Новый Структура;
        Событие.Вставить("date",        XMLСтрока(Строка.Дата));
        Событие.Вставить("level",       Строка(Строка.Уровень));
        Событие.Вставить("event",       Строка(Строка.Событие));
        Событие.Вставить("user",        Строка(Строка.ИмяПользователя));
        Событие.Вставить("computer",    Строка(Строка.Компьютер));
        Событие.Вставить("metadata",    ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "МетаданныеПредставление"));
        Событие.Вставить("data",        ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ДанныеПредставление"));
        Событие.Вставить("comment",     ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "Комментарий"));
        Событие.Вставить("transaction", ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, "ИдентификаторТранзакции"));
        МассивСобытий.Добавить(Событие);
    КонецЦикла;

    Результат = Новый Структура;
    Результат.Вставить("events", МассивСобытий);
    Результат.Вставить("total",  ВсегоЗаписей);

    Возврат ОтветJSON(Результат);
КонецФункции

Функция ПолучитьКолонкуЖурнала(Строка, ТаблицаЖурнала, ИмяКолонки)
    Если ТаблицаЖурнала.Колонки.Найти(ИмяКолонки) = Неопределено Тогда
        Возврат "";
    КонецЕсли;
    Возврат Строка(Строка[ИмяКолонки]);
КонецФункции

// GET /extensions — возвращает бинарные данные (.cfe) всех расширений в base64
Функция РасширенияGET(Запрос)
    Результат = Новый Массив;

    Попытка
        МассивРасширений = РасширенияКонфигурации.Получить();
    Исключение
        Возврат ОтветJSON(Результат);
    КонецПопытки;

    Для Каждого Расширение Из МассивРасширений Цикл
        Попытка
            Данные = Расширение.ПолучитьДанные();
            ОписаниеРасш = Новый Структура;
            ОписаниеРасш.Вставить("name", Расширение.Имя);
            ОписаниеРасш.Вставить("data", Base64Строка(Данные));
            Результат.Добавить(ОписаниеРасш);
        Исключение
        КонецПопытки;
    КонецЦикла;

    Возврат ОтветJSON(Результат);
КонецФункции

// ── Write-эндпоинты (создание/проведение документов) ────────────
//
// Разделение "создать" / "провести" — намеренное: СоздатьДокументPOST пишет
// объект ТОЛЬКО в режиме Запись (никогда Проведение) и не принимает флага
// "post" во входных данных. Провести можно только отдельным вызовом
// /document/post с уже полученным ref. Так ни один одиночный вызов не может
// провести документ — это структурно невозможно на стороне 1С, а не только
// на уровне Go-инструментов.

// POST /document — создать документ-черновик (без проведения)
Функция ДокументPOST(Запрос)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Возврат ОтветОшибкаКод(400, "invalid_json", ОписаниеОшибки());
    КонецПопытки;

    Если НЕ Параметры.Свойство("type") ИЛИ ПустаяСтрока(Параметры.type) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'type' обязательно", "type");
    КонецЕсли;

    ИмяТипа = Параметры.type;
    ОбъектМД = НайтиМетаданныеПоТипуИИмени("Document", ИмяТипа);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибкаКод(404, "unknown_document_type", "Тип документа '" + ИмяТипа + "' не найден", "type");
    КонецЕсли;

    НовыйДокумент = Неопределено;
    Попытка
        НовыйДокумент = Документы[ИмяТипа].СоздатьДокумент();

        Если Параметры.Свойство("attributes") И ТипЗнч(Параметры.attributes) = Тип("Структура") Тогда
            ОстальныеАтрибуты = ОтделитьСтандартныеРеквизитыДокумента(НовыйДокумент, Параметры.attributes);
            УстановитьРеквизиты(НовыйДокумент, ОбъектМД, ОстальныеАтрибуты);
        КонецЕсли;

        Если Параметры.Свойство("tabular_sections") И ТипЗнч(Параметры.tabular_sections) = Тип("Структура") Тогда
            УстановитьТабличныеЧасти(НовыйДокумент, ОбъектМД, Параметры.tabular_sections);
        КонецЕсли;

        // Намеренно только Запись — создание никогда не проводит документ.
        НовыйДокумент.Записать(РежимЗаписиДокумента.Запись);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ТекстыСообщений = ТекстыСообщенийПользователю();
        Если НЕ ПустаяСтрока(ТекстыСообщений) Тогда
            ТекстОшибки = ТекстОшибки + " | " + ТекстыСообщений;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("MCP: СоздатьДокумент", УровеньЖурналаРегистрации.Ошибка,
            ОбъектМД, , "тип=" + ИмяТипа + "; ошибка=" + ТекстОшибки);
        Возврат ОтветОшибкаКод(400, "write_failed", ТекстОшибки);
    КонецПопытки;

    ЗаписьЖурналаРегистрации("MCP: СоздатьДокумент", УровеньЖурналаРегистрации.Информация,
        ОбъектМД, НовыйДокумент.Ссылка, "тип=" + ИмяТипа + "; номер=" + Строка(НовыйДокумент.Номер));

    Результат = Новый Структура;
    Результат.Вставить("ref",    Строка(НовыйДокумент.Ссылка.УникальныйИдентификатор()));
    Результат.Вставить("number", Строка(НовыйДокумент.Номер));
    Результат.Вставить("date",   XMLСтрока(НовыйДокумент.Дата));
    Результат.Вставить("posted", НовыйДокумент.Проведен);

    Возврат ОтветJSON(Результат);
КонецФункции

// НайтиОбъектПоТипуИСсылке — общая часть всех *GET/*UPDATE/*ПометкаУдаления
// обработчиков для документов и справочников: разбор идентификатора и
// получение объекта через нужный менеджер (Документы/Справочники).
// Возвращает Структуру {ok, ref (Ссылка), object (Объект), errorResponse}.
Функция НайтиОбъектПоТипуИСсылке(ВидОбъекта, ИмяТипа, ИдСтрока)
    Результат = Новый Структура("ok, ref, object, errorResponse", Ложь, Неопределено, Неопределено, Неопределено);

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ВидОбъекта, ИмяТипа);
    Если ОбъектМД = Неопределено Тогда
        Результат.errorResponse = ОтветОшибкаКод(404, "unknown_object_type", "Тип '" + ИмяТипа + "' не найден", "type");
        Возврат Результат;
    КонецЕсли;

    Если ВидОбъекта = "Document" Тогда
        Менеджер = Документы;
    ИначеЕсли ВидОбъекта = "Catalog" Тогда
        Менеджер = Справочники;
    Иначе
        Результат.errorResponse = ОтветОшибкаКод(400, "validation_failed", "Неподдерживаемый object_kind: '" + ВидОбъекта + "' (ожидается Document или Catalog)", "object_kind");
        Возврат Результат;
    КонецЕсли;

    Ссылка = Неопределено;
    Объект = Неопределено;
    Попытка
        Ссылка = Менеджер[ИмяТипа].ПолучитьСсылку(Новый УникальныйИдентификатор(ИдСтрока));
        Объект = Ссылка.ПолучитьОбъект();
    Исключение
        Объект = Неопределено;
    КонецПопытки;

    Если Объект = Неопределено Тогда
        Результат.errorResponse = ОтветОшибкаКод(404, "not_found", "Объект не найден: " + ИдСтрока, "ref");
        Возврат Результат;
    КонецЕсли;

    Результат.ok = Истина;
    Результат.ref = Ссылка;
    Результат.object = Объект;
    Возврат Результат;
КонецФункции

// НайтиДокументПоТипуИСсылке — тонкая обёртка над НайтиОбъектПоТипуИСсылке для
// уже существующих вызовов (/document/post, /document/unpost, /document/{type}/{ref}),
// чтобы не менять их код.
Функция НайтиДокументПоТипуИСсылке(ИмяТипа, ИдСтрока)
    Возврат НайтиОбъектПоТипуИСсылке("Document", ИмяТипа, ИдСтрока);
КонецФункции

// ИзменитьПроведение — общая часть /document/post и /document/unpost: разбор
// запроса, поиск документа и запись в заданном РежимЗаписиДокумента.
Функция ИзменитьПроведение(Запрос, РежимЗаписи, ИмяСобытия)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Возврат ОтветОшибкаКод(400, "invalid_json", ОписаниеОшибки());
    КонецПопытки;

    Если НЕ Параметры.Свойство("type") ИЛИ ПустаяСтрока(Параметры.type) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'type' обязательно", "type");
    КонецЕсли;
    Если НЕ Параметры.Свойство("ref") ИЛИ ПустаяСтрока(Параметры.ref) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'ref' обязательно", "ref");
    КонецЕсли;

    ИмяТипа = Параметры.type;
    ИдСтрока = Параметры.ref;

    Найдено = НайтиДокументПоТипуИСсылке(ИмяТипа, ИдСтрока);
    Если НЕ Найдено.ok Тогда
        Возврат Найдено.errorResponse;
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени("Document", ИмяТипа);
    ОбъектДок = Найдено.object;

    Попытка
        ОбъектДок.Записать(РежимЗаписи);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ТекстыСообщений = ТекстыСообщенийПользователю();
        Если НЕ ПустаяСтрока(ТекстыСообщений) Тогда
            ТекстОшибки = ТекстОшибки + " | " + ТекстыСообщений;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("MCP: " + ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
            ОбъектМД, Найдено.ref, "тип=" + ИмяТипа + "; ошибка=" + ТекстОшибки);
        Возврат ОтветОшибкаКод(400, "posting_failed", ТекстОшибки);
    КонецПопытки;

    ЗаписьЖурналаРегистрации("MCP: " + ИмяСобытия, УровеньЖурналаРегистрации.Информация,
        ОбъектМД, Найдено.ref, "тип=" + ИмяТипа);

    Результат = Новый Структура;
    Результат.Вставить("ref",    ИдСтрока);
    Результат.Вставить("posted", ОбъектДок.Проведен);
    Результат.Вставить("date",   XMLСтрока(ОбъектДок.Дата));

    Возврат ОтветJSON(Результат);
КонецФункции

// POST /document/post — провести существующий документ-черновик
Функция ДокументПровестиPOST(Запрос)
    Возврат ИзменитьПроведение(Запрос, РежимЗаписиДокумента.Проведение, "ПровестиДокумент");
КонецФункции

// POST /document/unpost — отменить проведение документа
Функция ДокументРаспровестиPOST(Запрос)
    Возврат ИзменитьПроведение(Запрос, РежимЗаписиДокумента.ОтменаПроведения, "РаспровестиДокумент");
КонецФункции

// СформироватьОтветДокумента — собирает структуру ответа для документа, общую
// для ДокументGET и ДокументUPDATE (после изменения объект перечитывается тем
// же способом, чтобы вызывающий сразу видел актуальное состояние).
Функция СформироватьОтветДокумента(ОбъектДок, ОбъектМД, ИдСтрока, ИмяТипа)
    Результат = Новый Структура;
    Результат.Вставить("ref",           ИдСтрока);
    Результат.Вставить("type",          ИмяТипа);
    Результат.Вставить("number",        Строка(ОбъектДок.Номер));
    Результат.Вставить("date",          XMLСтрока(ОбъектДок.Дата));
    Результат.Вставить("posted",        ОбъектДок.Проведен);
    Результат.Вставить("deletion_mark", ОбъектДок.ПометкаУдаления);

    СериализоватьРеквизитыИТЧ(ОбъектДок, ОбъектМД, Результат);

    Возврат Результат;
КонецФункции

// GET /document/{type}/{ref} — прочитать текущее состояние документа
// (проведён/черновик, значения реквизитов) перед решением о проведении.
Функция ДокументGET(Запрос)
    ИмяТипа = Запрос.ПараметрыURL["type"];
    ИдСтрока = Запрос.ПараметрыURL["ref"];

    Найдено = НайтиДокументПоТипуИСсылке(ИмяТипа, ИдСтрока);
    Если НЕ Найдено.ok Тогда
        Возврат Найдено.errorResponse;
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени("Document", ИмяТипа);
    Возврат ОтветJSON(СформироватьОтветДокумента(Найдено.object, ОбъектМД, ИдСтрока, ИмяТипа));
КонецФункции

// ДокументUPDATE — обёртка ОбновитьОбъект для /document/update.
Функция ДокументUPDATE(Запрос)
    Возврат ОбновитьОбъект(Запрос, "Document", "ИзменитьДокумент");
КонецФункции

// ── Справочники (создание, изменение, чтение) ────────────────────

// СформироватьОтветСправочника — собирает структуру ответа для элемента
// справочника, общую для СправочникGET и СправочникUPDATE.
Функция СформироватьОтветСправочника(Объект, ОбъектМД, ИдСтрока, ИмяТипа)
    КодЗначение = "";
    Если ОбъектМД.ДлинаКода > 0 Тогда
        КодЗначение = Строка(Объект.Код);
    КонецЕсли;

    НаименованиеЗначение = "";
    Если ОбъектМД.ДлинаНаименования > 0 Тогда
        НаименованиеЗначение = Строка(Объект.Наименование);
    КонецЕсли;

    ЭтоГруппаЗначение = Ложь;
    Если ОбъектМД.Иерархический Тогда
        ЭтоГруппаЗначение = Объект.ЭтоГруппа;
    КонецЕсли;

    РодительЗначение = "";
    Если ОбъектМД.Иерархический И ЗначениеЗаполнено(Объект.Родитель) Тогда
        РодительЗначение = Строка(Объект.Родитель.УникальныйИдентификатор());
    КонецЕсли;

    ВладелецЗначение = "";
    Если ОбъектМД.Владельцы.Количество() > 0 И ЗначениеЗаполнено(Объект.Владелец) Тогда
        ВладелецЗначение = Строка(Объект.Владелец.УникальныйИдентификатор());
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("ref",           ИдСтрока);
    Результат.Вставить("type",          ИмяТипа);
    Результат.Вставить("code",          КодЗначение);
    Результат.Вставить("description",  НаименованиеЗначение);
    Результат.Вставить("is_group",      ЭтоГруппаЗначение);
    Результат.Вставить("deletion_mark", Объект.ПометкаУдаления);
    Результат.Вставить("parent",        РодительЗначение);
    Результат.Вставить("owner",         ВладелецЗначение);

    СериализоватьРеквизитыИТЧ(Объект, ОбъектМД, Результат);

    Возврат Результат;
КонецФункции

// GET /catalog/{type}/{ref}
Функция СправочникGET(Запрос)
    ИмяТипа = Запрос.ПараметрыURL["type"];
    ИдСтрока = Запрос.ПараметрыURL["ref"];

    Найдено = НайтиОбъектПоТипуИСсылке("Catalog", ИмяТипа, ИдСтрока);
    Если НЕ Найдено.ok Тогда
        Возврат Найдено.errorResponse;
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени("Catalog", ИмяТипа);
    Возврат ОтветJSON(СформироватьОтветСправочника(Найдено.object, ОбъектМД, ИдСтрока, ИмяТипа));
КонецФункции

// СправочникUPDATE — обёртка ОбновитьОбъект для /catalog/update.
Функция СправочникUPDATE(Запрос)
    Возврат ОбновитьОбъект(Запрос, "Catalog", "ИзменитьЭлементСправочника");
КонецФункции

// POST /catalog — создать элемент (или группу, если is_group=true) справочника.
// Как и ДокументPOST, всегда просто Записать() — у справочников нет понятия
// "проведения", поэтому дополнительных гарантий здесь не требуется.
Функция СправочникPOST(Запрос)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Возврат ОтветОшибкаКод(400, "invalid_json", ОписаниеОшибки());
    КонецПопытки;

    Если НЕ Параметры.Свойство("type") ИЛИ ПустаяСтрока(Параметры.type) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'type' обязательно", "type");
    КонецЕсли;

    ИмяТипа = Параметры.type;
    ОбъектМД = НайтиМетаданныеПоТипуИИмени("Catalog", ИмяТипа);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибкаКод(404, "unknown_catalog_type", "Справочник '" + ИмяТипа + "' не найден", "type");
    КонецЕсли;

    ЭтоГруппа = Ложь;
    Если Параметры.Свойство("is_group") Тогда
        ЭтоГруппа = Параметры.is_group = Истина;
    КонецЕсли;
    Если ЭтоГруппа И НЕ ОбъектМД.Иерархический Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Справочник '" + ИмяТипа + "' не является иерархическим — группы недопустимы", "is_group");
    КонецЕсли;

    ИмяТипаВладельца = Неопределено;
    Если Параметры.Свойство("owner_type") И ЗначениеЗаполнено(Параметры.owner_type) Тогда
        ИмяТипаВладельца = Параметры.owner_type;
    КонецЕсли;

    НовыйЭлемент = Неопределено;
    Попытка
        Если ЭтоГруппа Тогда
            НовыйЭлемент = Справочники[ИмяТипа].СоздатьГруппу();
        Иначе
            НовыйЭлемент = Справочники[ИмяТипа].СоздатьЭлемент();
        КонецЕсли;

        ОстальныеАтрибуты = Новый Структура;
        Если Параметры.Свойство("attributes") И ТипЗнч(Параметры.attributes) = Тип("Структура") Тогда
            ОстальныеАтрибуты = ОтделитьСтандартныеРеквизитыСправочника(НовыйЭлемент, ОбъектМД, Параметры.attributes, ИмяТипаВладельца);
        КонецЕсли;
        УстановитьРеквизиты(НовыйЭлемент, ОбъектМД, ОстальныеАтрибуты);

        Если Параметры.Свойство("tabular_sections") И ТипЗнч(Параметры.tabular_sections) = Тип("Структура") Тогда
            УстановитьТабличныеЧасти(НовыйЭлемент, ОбъектМД, Параметры.tabular_sections);
        КонецЕсли;

        НовыйЭлемент.Записать();
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ТекстыСообщений = ТекстыСообщенийПользователю();
        Если НЕ ПустаяСтрока(ТекстыСообщений) Тогда
            ТекстОшибки = ТекстОшибки + " | " + ТекстыСообщений;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("MCP: СоздатьЭлементСправочника", УровеньЖурналаРегистрации.Ошибка,
            ОбъектМД, , "тип=" + ИмяТипа + "; ошибка=" + ТекстОшибки);
        Возврат ОтветОшибкаКод(400, "write_failed", ТекстОшибки);
    КонецПопытки;

    ЗаписьЖурналаРегистрации("MCP: СоздатьЭлементСправочника", УровеньЖурналаРегистрации.Информация,
        ОбъектМД, НовыйЭлемент.Ссылка, "тип=" + ИмяТипа);

    КодЗначение = "";
    Если ОбъектМД.ДлинаКода > 0 Тогда
        КодЗначение = Строка(НовыйЭлемент.Код);
    КонецЕсли;
    НаименованиеЗначение = "";
    Если ОбъектМД.ДлинаНаименования > 0 Тогда
        НаименованиеЗначение = Строка(НовыйЭлемент.Наименование);
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("ref",         Строка(НовыйЭлемент.Ссылка.УникальныйИдентификатор()));
    Результат.Вставить("code",        КодЗначение);
    Результат.Вставить("description", НаименованиеЗначение);
    Результат.Вставить("is_group",    ЭтоГруппа);

    Возврат ОтветJSON(Результат);
КонецФункции

// ОбновитьОбъект — общая часть /catalog/update и /document/update: разбор
// запроса, поиск объекта, применение реквизитов/табличных частей и запись.
// Табличные части, указанные в запросе, заменяются ЦЕЛИКОМ (Очистить() перед
// заполнением) — секции, не упомянутые в tabular_sections, не трогаются.
// Документ пишется только в режиме Запись — update никогда не проводит и не
// распроводит документ (для этого есть отдельные post_document/unpost_document).
Функция ОбновитьОбъект(Запрос, ВидОбъекта, ИмяСобытия)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Возврат ОтветОшибкаКод(400, "invalid_json", ОписаниеОшибки());
    КонецПопытки;

    Если НЕ Параметры.Свойство("type") ИЛИ ПустаяСтрока(Параметры.type) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'type' обязательно", "type");
    КонецЕсли;
    Если НЕ Параметры.Свойство("ref") ИЛИ ПустаяСтрока(Параметры.ref) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'ref' обязательно", "ref");
    КонецЕсли;

    ИмяТипа = Параметры.type;
    ИдСтрока = Параметры.ref;

    Найдено = НайтиОбъектПоТипуИСсылке(ВидОбъекта, ИмяТипа, ИдСтрока);
    Если НЕ Найдено.ok Тогда
        Возврат Найдено.errorResponse;
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ВидОбъекта, ИмяТипа);
    Объект = Найдено.object;

    Попытка
        Если Параметры.Свойство("attributes") И ТипЗнч(Параметры.attributes) = Тип("Структура") Тогда
            Если ВидОбъекта = "Catalog" Тогда
                ОстальныеАтрибуты = ОтделитьСтандартныеРеквизитыСправочника(Объект, ОбъектМД, Параметры.attributes);
            Иначе
                ОстальныеАтрибуты = ОтделитьСтандартныеРеквизитыДокумента(Объект, Параметры.attributes);
            КонецЕсли;
            УстановитьРеквизиты(Объект, ОбъектМД, ОстальныеАтрибуты);
        КонецЕсли;

        Если Параметры.Свойство("tabular_sections") И ТипЗнч(Параметры.tabular_sections) = Тип("Структура") Тогда
            Для Каждого ИмяТСИЗначение Из Параметры.tabular_sections Цикл
                Объект[ИмяТСИЗначение.Ключ].Очистить();
            КонецЦикла;
            УстановитьТабличныеЧасти(Объект, ОбъектМД, Параметры.tabular_sections);
        КонецЕсли;

        Если ВидОбъекта = "Document" Тогда
            Объект.Записать(РежимЗаписиДокумента.Запись);
        Иначе
            Объект.Записать();
        КонецЕсли;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ТекстыСообщений = ТекстыСообщенийПользователю();
        Если НЕ ПустаяСтрока(ТекстыСообщений) Тогда
            ТекстОшибки = ТекстОшибки + " | " + ТекстыСообщений;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("MCP: " + ИмяСобытия, УровеньЖурналаРегистрации.Ошибка,
            ОбъектМД, Найдено.ref, "тип=" + ИмяТипа + "; ошибка=" + ТекстОшибки);
        Возврат ОтветОшибкаКод(400, "write_failed", ТекстОшибки);
    КонецПопытки;

    ЗаписьЖурналаРегистрации("MCP: " + ИмяСобытия, УровеньЖурналаРегистрации.Информация,
        ОбъектМД, Найдено.ref, "тип=" + ИмяТипа);

    Если ВидОбъекта = "Document" Тогда
        Возврат ОтветJSON(СформироватьОтветДокумента(Объект, ОбъектМД, ИдСтрока, ИмяТипа));
    Иначе
        Возврат ОтветJSON(СформироватьОтветСправочника(Объект, ОбъектМД, ИдСтрока, ИмяТипа));
    КонецЕсли;
КонецФункции

// POST /object/deletion-mark — установить/снять пометку удаления у документа
// или элемента справочника. Метод платформы УстановитьПометкуУдаления сам
// записывает объект — отдельного Записать() не требуется. Если у проведённого
// документа при установке пометки распроведение выполняется бизнес-логикой
// конфигурации (не гарантировано платформой) — итоговое состояние "posted"
// в ответе отражает то, что получилось на самом деле, а не предположение.
// Жёсткого удаления (физического) здесь нет и не будет — только пометка.
Функция ПометкаУдаленияPOST(Запрос)
    Попытка
        Параметры = РазобратьJSON(Запрос.ПолучитьТелоКакСтроку());
    Исключение
        Возврат ОтветОшибкаКод(400, "invalid_json", ОписаниеОшибки());
    КонецПопытки;

    Если НЕ Параметры.Свойство("object_kind") ИЛИ ПустаяСтрока(Параметры.object_kind) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'object_kind' обязательно (Document или Catalog)", "object_kind");
    КонецЕсли;
    Если НЕ Параметры.Свойство("type") ИЛИ ПустаяСтрока(Параметры.type) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'type' обязательно", "type");
    КонецЕсли;
    Если НЕ Параметры.Свойство("ref") ИЛИ ПустаяСтрока(Параметры.ref) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Поле 'ref' обязательно", "ref");
    КонецЕсли;

    ВидОбъекта = Параметры.object_kind;
    ИмяТипа = Параметры.type;
    ИдСтрока = Параметры.ref;
    Метка = Истина;
    Если Параметры.Свойство("mark") Тогда
        Метка = Параметры.mark = Истина;
    КонецЕсли;

    Найдено = НайтиОбъектПоТипуИСсылке(ВидОбъекта, ИмяТипа, ИдСтрока);
    Если НЕ Найдено.ok Тогда
        Возврат Найдено.errorResponse;
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ВидОбъекта, ИмяТипа);
    Объект = Найдено.object;

    Попытка
        Объект.УстановитьПометкуУдаления(Метка);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        ТекстыСообщений = ТекстыСообщенийПользователю();
        Если НЕ ПустаяСтрока(ТекстыСообщений) Тогда
            ТекстОшибки = ТекстОшибки + " | " + ТекстыСообщений;
        КонецЕсли;
        ЗаписьЖурналаРегистрации("MCP: ПометкаУдаления", УровеньЖурналаРегистрации.Ошибка,
            ОбъектМД, Найдено.ref, "тип=" + ИмяТипа + "; метка=" + Строка(Метка) + "; ошибка=" + ТекстОшибки);
        Возврат ОтветОшибкаКод(400, "write_failed", ТекстОшибки);
    КонецПопытки;

    ЗаписьЖурналаРегистрации("MCP: ПометкаУдаления", УровеньЖурналаРегистрации.Информация,
        ОбъектМД, Найдено.ref, "тип=" + ИмяТипа + "; метка=" + Строка(Метка));

    Результат = Новый Структура;
    Результат.Вставить("ref",           ИдСтрока);
    Результат.Вставить("deletion_mark", Метка);
    Если ВидОбъекта = "Document" Тогда
        Результат.Вставить("posted", Объект.Проведен);
    КонецЕсли;

    Возврат ОтветJSON(Результат);
КонецФункции

// ── Поиск ссылок (резолвинг человекочитаемых названий в GUID) ────

// GET /find?type=Catalog|Document&name=ИмяВидаМетаданных&query=текст&limit=20&include_marked=false
// Ключевой инструмент для LLM: перед созданием/изменением документа со
// ссылочными реквизитами (Контрагент, Организация, Номенклатура...) нужно
// получить GUID, а не изобретать его. Область поддержки в v1 — Catalog и
// Document (наиболее частые случаи); для прочих видов метаданных возвращается
// понятная ошибка, а не тихий пустой результат.
Функция ПоискСсылкиGET(Запрос)
    ВидОбъекта  = ПараметрЗапроса(Запрос, "type");
    ИмяТипа     = ПараметрЗапроса(Запрос, "name");
    ТекстПоиска = ПараметрЗапроса(Запрос, "query");

    Если ПустаяСтрока(ВидОбъекта) ИЛИ ПустаяСтрока(ИмяТипа) Тогда
        Возврат ОтветОшибкаКод(400, "validation_failed", "Параметры 'type' и 'name' обязательны", "type");
    КонецЕсли;

    ОбъектМД = НайтиМетаданныеПоТипуИИмени(ВидОбъекта, ИмяТипа);
    Если ОбъектМД = Неопределено Тогда
        Возврат ОтветОшибкаКод(404, "unknown_object_type", "Тип '" + ИмяТипа + "' не найден", "name");
    КонецЕсли;

    Лимит = 20;
    СтрокаЛимита = ПараметрЗапроса(Запрос, "limit");
    Если НЕ ПустаяСтрока(СтрокаЛимита) Тогда
        Попытка
            Лимит = Мин(Число(СтрокаЛимита), 50);
        Исключение
        КонецПопытки;
    КонецЕсли;

    ВключатьПомеченные = (ВРег(ПараметрЗапроса(Запрос, "include_marked")) = "TRUE");
    Шаблон = "%" + ЭкранироватьДляПодобно(ТекстПоиска) + "%";

    Элементы = Новый Массив;

    Если ВидОбъекта = "Catalog" Тогда
        УсловияПоиска = Новый Массив;
        Если ОбъектМД.ДлинаНаименования > 0 Тогда
            УсловияПоиска.Добавить("Т.Наименование ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""");
        КонецЕсли;
        Если ОбъектМД.ДлинаКода > 0 Тогда
            УсловияПоиска.Добавить("Т.Код ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""");
        КонецЕсли;
        Если УсловияПоиска.Количество() = 0 Тогда
            Возврат ОтветОшибкаКод(400, "validation_failed", "У справочника '" + ИмяТипа + "' нет ни Наименования, ни Кода для поиска", "name");
        КонецЕсли;

        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Лимит) + " Т.Ссылка КАК Ссылка, Т.ПометкаУдаления КАК ПометкаУдаления";
        Если ОбъектМД.Иерархический Тогда
            ТекстЗапроса = ТекстЗапроса + ", Т.ЭтоГруппа КАК ЭтоГруппа";
        КонецЕсли;
        ТекстЗапроса = ТекстЗапроса + " ИЗ Справочник." + ИмяТипа + " КАК Т ГДЕ (" + СтрСоединить(УсловияПоиска, " ИЛИ ") + ")";
        Если НЕ ВключатьПомеченные Тогда
            ТекстЗапроса = ТекстЗапроса + " И НЕ Т.ПометкаУдаления";
        КонецЕсли;

        Запрос1С = Новый Запрос(ТекстЗапроса);
        Запрос1С.УстановитьПараметр("Шаблон", Шаблон);
        Выборка = Запрос1С.Выполнить().Выбрать();

        Пока Выборка.Следующий() Цикл
            КодЗначение = "";
            Если ОбъектМД.ДлинаКода > 0 Тогда
                КодЗначение = Строка(Выборка.Ссылка.Код);
            КонецЕсли;
            ЭтоГруппаЗначение = Ложь;
            Если ОбъектМД.Иерархический Тогда
                ЭтоГруппаЗначение = Выборка.ЭтоГруппа;
            КонецЕсли;

            Элемент = Новый Структура;
            Элемент.Вставить("ref",          Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            Элемент.Вставить("presentation", Строка(Выборка.Ссылка));
            Элемент.Вставить("code",         КодЗначение);
            Элемент.Вставить("type_name",    "СправочникСсылка." + ИмяТипа);
            Элемент.Вставить("deletion_mark",Выборка.ПометкаУдаления);
            Элемент.Вставить("is_group",     ЭтоГруппаЗначение);
            Элементы.Добавить(Элемент);
        КонецЦикла;

    ИначеЕсли ВидОбъекта = "Document" Тогда
        ТекстЗапроса = "ВЫБРАТЬ ПЕРВЫЕ " + Строка(Лимит) + " Т.Ссылка КАК Ссылка, Т.ПометкаУдаления КАК ПометкаУдаления, Т.Проведен КАК Проведен";
        ТекстЗапроса = ТекстЗапроса + " ИЗ Документ." + ИмяТипа + " КАК Т ГДЕ Т.Номер ПОДОБНО &Шаблон СПЕЦСИМВОЛ ""~""";
        Если НЕ ВключатьПомеченные Тогда
            ТекстЗапроса = ТекстЗапроса + " И НЕ Т.ПометкаУдаления";
        КонецЕсли;
        ТекстЗапроса = ТекстЗапроса + " УПОРЯДОЧИТЬ ПО Т.Дата УБЫВ";

        Запрос1С = Новый Запрос(ТекстЗапроса);
        Запрос1С.УстановитьПараметр("Шаблон", Шаблон);
        Выборка = Запрос1С.Выполнить().Выбрать();

        Пока Выборка.Следующий() Цикл
            Элемент = Новый Структура;
            Элемент.Вставить("ref",           Строка(Выборка.Ссылка.УникальныйИдентификатор()));
            Элемент.Вставить("presentation",  Строка(Выборка.Ссылка));
            Элемент.Вставить("code",          Строка(Выборка.Ссылка.Номер));
            Элемент.Вставить("type_name",     "ДокументСсылка." + ИмяТипа);
            Элемент.Вставить("deletion_mark", Выборка.ПометкаУдаления);
            Элемент.Вставить("is_group",      Ложь);
            Элемент.Вставить("date",          XMLСтрока(Выборка.Ссылка.Дата));
            Элемент.Вставить("posted",        Выборка.Проведен);
            Элементы.Добавить(Элемент);
        КонецЦикла;

    Иначе
        Возврат ОтветОшибкаКод(400, "validation_failed", "Неподдерживаемый type: '" + ВидОбъекта + "' (ожидается Catalog или Document)", "type");
    КонецЕсли;

    Результат = Новый Структура;
    Результат.Вставить("items",     Элементы);
    Результат.Вставить("total",     Элементы.Количество());
    Результат.Вставить("truncated", Элементы.Количество() >= Лимит);

    Возврат ОтветJSON(Результат);
КонецФункции
